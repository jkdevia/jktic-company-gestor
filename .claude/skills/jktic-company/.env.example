# Endpoint SOAP de JKTIC (SugarCRM). NO subir .env al repositorio.
CONDOR_SOAP_URL=
CONDOR_SOAP_USER=
# Clave de aplicación jkapp_... (CRM, modulo jk_app_passwords). NO usar texto plano; alternativa: MD5 en minusculas.
CONDOR_SOAP_PASSWORD=
# Versión enviada en user_auth (normalmente "1.0")
CONDOR_SOAP_VERSION=1.0
# Opcional: id del artículo jkk_articles con la relación de módulos (por defecto el de JKTIC-VEN)
CONDOR_MODULES_ARTICLE_ID=
# Código del agente (campo "Creador" de la planilla Instrucciones Agentes), p. ej. <usuario>-<equipo>
CONDOR_AGENT_CODE=
# Opcional: id del artículo jkk_articles con el catálogo de instrucciones (por defecto JKTIC COMPANY GESTOR CATALOGO INDEX)
CONDOR_CATALOG_ARTICLE_ID=
